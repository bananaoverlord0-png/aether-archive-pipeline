# =============================================================================
# Aether Archive Pipeline — Environment Variables
# Copy to .env and fill real values. NEVER commit .env.
# =============================================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO
DATA_ROOT=./data

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aether:aether@localhost:5432/aether_archive
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether
POSTGRES_DB=aether_archive

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aether-archive
S3_REGION=us-east-1

# --- LLM Providers (modular adapters) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
LLM_DEFAULT_PROVIDER=anthropic
LLM_SCRIPT_MODEL=claude-sonnet-4-20250514
LLM_RESEARCH_MODEL=claude-sonnet-4-20250514

# --- Research / Search ---
SERPER_API_KEY=
TAVILY_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=
# Prefer peer-reviewed / institutional sources; rate-limit respected

# --- Narration / TTS ---
TTS_PROVIDER=voice   # voice | elevenlabs | fish | openai
VOICE_DEFAULT_ID=helix   # dark cinematic male
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
OPENAI_TTS_VOICE=onyx

# --- Image / Video Generation ---
IMAGE_PROVIDER=grok_imagine   # grok_imagine | canva | higgsfield | runway | pexels
GROK_IMAGINE_ENABLED=true
CANVA_ACCESS_TOKEN=
HIGGSFIELD_API_KEY=
RUNWAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Video Assembly ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DEFAULT_RESOLUTION=1920x1080
DEFAULT_FPS=30
DEFAULT_TARGET_DURATION_MIN=10
DEFAULT_TARGET_DURATION_MAX=15

# --- YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_UPLOAD_PRIVACY=private   # private | unlisted | public
YOUTUBE_CATEGORY_ID=27           # Education / Science & Technology often used for docs
YOUTUBE_DEFAULT_LANGUAGE=en
YOUTUBE_MADE_FOR_KIDS=false

# --- Analytics Feedback ---
YOUTUBE_ANALYTICS_ENABLED=false
ANALYTICS_LOOKBACK_DAYS=28

# --- Feature Flags ---
AUTO_TOPIC_SELECTION=false
AUTO_SCRIPT_APPROVE=false
AUTO_UPLOAD=false
AUTO_SCHEDULE=false
REQUIRE_HUMAN_REVIEW=true

# --- Observability ---
SENTRY_DSN=
PROMETHEUS_PORT=9090

# --- Rate Limits / Safety ---
MAX_CONCURRENT_RENDERS=2
RESEARCH_RATE_LIMIT_PER_MIN=30
CLAIM_VERIFICATION_STRICT=true
